# ─── Database ────────────────────────────────────────────────────────────────
# Local Docker Compose:
#   postgresql://quizora:<password>@localhost:5432/quizora
# Production (Neon):
#   postgresql://<user>:<password>@<host>.neon.tech/<db>?sslmode=require
DATABASE_URL=postgresql://quizora:changeme@localhost:5432/quizora

# ─── Docker Compose (local dev only) ─────────────────────────────────────────
POSTGRES_DB=quizora
POSTGRES_USER=quizora
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5432

# ─── Session (iron-session) ────────────────────────────────────────────────────
# Must be at least 32 characters. Generate with: openssl rand -base64 32
SESSION_SECRET=replace-this-with-a-32-plus-char-secret-do-not-commit

# ─── Application ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── AI Provider (Google Gemini) ─────────────────────────────────────────────
# Obtain at: https://aistudio.google.com/app/apikey
# Used for: PDF question import and AI-assisted text grading
GEMINI_API_KEY=
# Model to use — verify current free-tier models at Google AI Studio
GEMINI_MODEL=gemini-2.5-flash

# ─── File Storage ─────────────────────────────────────────────────────────────
# LOCAL: files stored in ./uploads/ (dev only, do not use in production)
# S3 / R2: set STORAGE_PROVIDER=s3 and fill the values below
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./uploads

# S3 / Cloudflare R2 (production)
# STORAGE_PROVIDER=s3
# STORAGE_BUCKET=
# STORAGE_REGION=
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# STORAGE_ENDPOINT=       # for R2: https://<account-id>.r2.cloudflarestorage.com

# ─── Reconnect / heartbeat tuning ────────────────────────────────────────────
# How often the client sends a heartbeat (seconds)
HEARTBEAT_INTERVAL_SECONDS=30
