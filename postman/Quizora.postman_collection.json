{
  "info": {
    "name": "Quizora API",
    "description": "Quizora — online quiz platform API collection. Set {{baseUrl}} to http://localhost:3000 for local dev.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "quizora-v1"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000", "type": "string" }
  ],
  "item": [
    {
      "name": "Admin Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/admin/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}"
            },
            "description": "Returns session cookie on success. Use the cookie in subsequent requests."
          }
        },
        {
          "name": "Me (get current session)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/admin/auth/me",
            "description": "Returns the currently authenticated admin user."
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/admin/auth/logout",
            "description": "Destroys the admin session cookie."
          }
        }
      ]
    },
    {
      "name": "Courses",
      "description": "Course CRUD — requires admin session cookie.",
      "item": [
        {
          "name": "List courses",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/admin/courses",
            "description": "Returns all courses with exam count."
          }
        },
        {
          "name": "Create course",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/admin/courses",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Machine Learning\",\n  \"code\": \"IE403\",\n  \"description\": \"Introduction to Machine Learning\"\n}"
            },
            "description": "Code is auto-uppercased and must be alphanumeric."
          }
        },
        {
          "name": "Get course",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/admin/courses/{{courseId}}",
            "description": "Returns course details including its exams."
          }
        },
        {
          "name": "Update course",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/admin/courses/{{courseId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Machine Learning (Updated)\",\n  \"description\": \"Updated description\"\n}"
            }
          }
        },
        {
          "name": "Archive course",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/admin/courses/{{courseId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isActive\": false\n}"
            }
          }
        },
        {
          "name": "Delete course",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/admin/courses/{{courseId}}",
            "description": "Only succeeds if the course has no exams."
          }
        }
      ]
    },
    {
      "name": "Exams",
      "description": "Exam CRUD and settings — requires admin session cookie.",
      "item": [
        {
          "name": "List exams",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/admin/exams", "description": "Returns all exams with course info and counts." }
        },
        {
          "name": "Create exam",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/admin/exams",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"courseId\": \"{{courseId}}\",\n  \"title\": \"IE403 — Quiz 1: Supervised Learning\",\n  \"description\": \"20 MCQs on regression and classification\",\n  \"instructorName\": \"Prof. Arunava Chakravarty\",\n  \"taNames\": [\"TA One\", \"TA Two\"],\n  \"availabilityStart\": \"2024-09-01T09:00:00Z\",\n  \"availabilityEnd\": \"2024-09-01T11:00:00Z\",\n  \"durationMinutes\": 90,\n  \"timerMode\": \"WHOLE_QUIZ\",\n  \"attemptsAllowed\": 1,\n  \"randomizeQuestions\": true,\n  \"randomizeOptions\": true,\n  \"allowBacktracking\": true,\n  \"allowExternalStudents\": false,\n  \"continueAfterAvailability\": false,\n  \"fullScreenRequired\": false,\n  \"defaultMarks\": 1,\n  \"defaultNegativeMarks\": 0,\n  \"msqGradingPolicy\": \"STRICT\",\n  \"textGradingMode\": \"EXACT\",\n  \"resultRelease\": \"AUTO\"\n}"
            },
            "description": "Slug is auto-generated. Exam starts in DRAFT status."
          }
        },
        {
          "name": "Get exam",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/admin/exams/{{examId}}",
            "description": "Returns exam details with course info and counts."
          }
        },
        {
          "name": "Update exam settings",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/admin/exams/{{examId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"IE403 — Quiz 1 (Updated)\",\n  \"durationMinutes\": 120,\n  \"randomizeQuestions\": false\n}"
            }
          }
        },
        {
          "name": "Delete exam",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/admin/exams/{{examId}}",
            "description": "Only allowed if exam has no student attempts."
          }
        },
        {
          "name": "Publish exam",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/admin/exams/{{examId}}/publish",
            "description": "DRAFT → PUBLISHED. Validates title, instructor, duration."
          }
        },
        {
          "name": "Close exam",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/admin/exams/{{examId}}/close",
            "description": "PUBLISHED/ACTIVE → CLOSED. Prevents new attempts."
          }
        },
        {
          "name": "Unpublish exam",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/admin/exams/{{examId}}/unpublish",
            "description": "PUBLISHED → DRAFT. Only allowed if no attempts exist."
          }
        }
      ]
    },
    {
      "name": "Exam Roster",
      "description": "Student roster management — requires admin session cookie.",
      "item": [
        {
          "name": "List roster",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/admin/exams/{{examId}}/roster" }
        },
        {
          "name": "Add student",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/admin/exams/{{examId}}/roster",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"studentId\": \"202301001\",\n  \"name\": \"Rahul Sharma\",\n  \"email\": \"202301001@dau.ac.in\"\n}"
            },
            "description": "Upserts — updates name/email if student already enrolled."
          }
        },
        {
          "name": "Remove student",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/admin/exams/{{examId}}/roster/202301001",
            "description": "Remove a student from the exam roster by their student ID."
          }
        },
        {
          "name": "Upload roster CSV",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/admin/exams/{{examId}}/roster/csv",
            "body": {
              "mode": "formdata",
              "formdata": [{ "key": "csv", "type": "file", "src": "/path/to/roster.csv" }]
            },
            "description": "CSV format: student_id,name,email — one row per student, header optional. Max 2 MB."
          }
        }
      ]
    },
    {
      "name": "Questions",
      "description": "Question CRUD per exam — requires admin session cookie. Correct answers are included in admin responses only.",
      "item": [
        {
          "name": "List questions",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/admin/exams/{{examId}}/questions",
            "description": "Returns all questions for the exam ordered by displayOrder, with options and media."
          }
        },
        {
          "name": "Create MCQ question",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/admin/exams/{{examId}}/questions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"MCQ\",\n  \"text\": \"Which of the following is a supervised learning algorithm?\",\n  \"marks\": 2,\n  \"negativeMarks\": 0.5,\n  \"options\": [\n    { \"text\": \"K-Means\", \"isCorrect\": false, \"displayOrder\": 0 },\n    { \"text\": \"Decision Tree\", \"isCorrect\": true, \"displayOrder\": 1 },\n    { \"text\": \"DBSCAN\", \"isCorrect\": false, \"displayOrder\": 2 },\n    { \"text\": \"PCA\", \"isCorrect\": false, \"displayOrder\": 3 }\n  ]\n}"
            },
            "description": "Creates an MCQ. Exactly one option must have isCorrect: true."
          }
        },
        {
          "name": "Create MSQ question",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/admin/exams/{{examId}}/questions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"MSQ\",\n  \"text\": \"Which algorithms are classification algorithms?\",\n  \"marks\": 3,\n  \"negativeMarks\": 0,\n  \"options\": [\n    { \"text\": \"SVM\", \"isCorrect\": true, \"displayOrder\": 0 },\n    { \"text\": \"KNN\", \"isCorrect\": true, \"displayOrder\": 1 },\n    { \"text\": \"K-Means\", \"isCorrect\": false, \"displayOrder\": 2 },\n    { \"text\": \"Logistic Regression\", \"isCorrect\": true, \"displayOrder\": 3 }\n  ]\n}"
            }
          }
        },
        {
          "name": "Create True/False question",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/admin/exams/{{examId}}/questions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"TRUE_FALSE\",\n  \"text\": \"Linear regression can be used for classification tasks.\",\n  \"marks\": 1,\n  \"negativeMarks\": 0.25,\n  \"options\": [\n    { \"text\": \"True\", \"isCorrect\": false, \"displayOrder\": 0 },\n    { \"text\": \"False\", \"isCorrect\": true, \"displayOrder\": 1 }\n  ]\n}"
            }
          }
        },
        {
          "name": "Create Numerical question",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/admin/exams/{{examId}}/questions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"NUMERICAL\",\n  \"text\": \"If a linear regression model has R² = 0.85, what percentage of variance is explained?\",\n  \"marks\": 2,\n  \"negativeMarks\": 0,\n  \"numericalAnswer\": 85,\n  \"numericalTolerance\": 0\n}"
            }
          }
        },
        {
          "name": "Create Short Text question",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/admin/exams/{{examId}}/questions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"SHORT_TEXT\",\n  \"text\": \"What does SVM stand for?\",\n  \"marks\": 1,\n  \"negativeMarks\": 0,\n  \"textAnswer\": \"Support Vector Machine\"\n}"
            }
          }
        },
        {
          "name": "Get question",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/admin/exams/{{examId}}/questions/{{questionId}}"
          }
        },
        {
          "name": "Update question",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/admin/exams/{{examId}}/questions/{{questionId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"marks\": 3,\n  \"negativeMarks\": 1\n}"
            },
            "description": "Partial update. Blocked if question has student responses."
          }
        },
        {
          "name": "Delete question",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/admin/exams/{{examId}}/questions/{{questionId}}",
            "description": "Blocked if question has student responses."
          }
        },
        {
          "name": "Reorder questions",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/admin/exams/{{examId}}/questions/reorder",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"questions\": [\n    { \"id\": \"{{questionId}}\", \"displayOrder\": 1 }\n  ]\n}"
            },
            "description": "Updates displayOrder for all specified questions. All IDs must belong to this exam."
          }
        }
      ]
    },
    {
      "name": "Student Exam (Phase 4)",
      "description": "Student-facing endpoints — implemented in Phase 4.",
      "item": [
        {
          "name": "Validate identity",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/exam/:slug/validate",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Rahul Sharma\",\n  \"studentId\": \"202301001\",\n  \"email\": \"202301001@dau.ac.in\"\n}"
            }
          }
        },
        {
          "name": "Start / resume attempt",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/exam/:slug/start"
          }
        },
        {
          "name": "Save answer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/exam/:slug/answer",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"attemptId\": \"<attempt_id>\",\n  \"sessionToken\": \"<session_token>\",\n  \"questionId\": \"<question_id>\",\n  \"selectedOptionIds\": [\"<option_id>\"]\n}"
            }
          }
        },
        {
          "name": "Submit exam",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/exam/:slug/submit",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"attemptId\": \"<attempt_id>\",\n  \"sessionToken\": \"<session_token>\"\n}"
            }
          }
        },
        {
          "name": "Log exam event",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/exam/:slug/event",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"attemptId\": \"<attempt_id>\",\n  \"sessionToken\": \"<session_token>\",\n  \"eventType\": \"TAB_SWITCHED\",\n  \"metadata\": {}\n}"
            }
          }
        },
        {
          "name": "Get result",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/exam/:slug/result?attemptId=<attempt_id>"
          }
        }
      ]
    }
  ]
}
